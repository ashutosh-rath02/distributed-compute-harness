{
  "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus"}],
  "title": "Home Harness",
  "uid": "home-harness",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-6h", "to": "now"},
  "tags": ["home-harness"],
  "templating": {"list": []},
  "panels": [
    {"id": 1, "type": "stat", "title": "Ready devices", "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [{"expr": "harness_nodes{state=\"READY\"}", "refId": "A"}],
     "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}},
    {"id": 2, "type": "stat", "title": "Taking work now", "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [{"expr": "harness_nodes_taking_work", "refId": "A"}]},
    {"id": 3, "type": "stat", "title": "Queue depth", "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [{"expr": "harness_queue_depth", "refId": "A"}]},
    {"id": 4, "type": "stat", "title": "Oldest queued wait", "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [{"expr": "harness_queue_oldest_wait_seconds", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 120}, {"color": "red", "value": 600}]}}}},
    {"id": 5, "type": "stat", "title": "Ready (readyz)", "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [{"expr": "harness_ready", "refId": "A"}],
     "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "NOT READY", "color": "red"}, "1": {"text": "ready", "color": "green"}}}]}}},
    {"id": 6, "type": "stat", "title": "Failover term", "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [{"expr": "harness_failover_term", "refId": "A"}]},

    {"id": 10, "type": "timeseries", "title": "Workloads finished per minute, by outcome", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [{"expr": "sum by (outcome) (rate(harness_workloads_finished_total[5m])) * 60", "legendFormat": "{{outcome}}", "refId": "A"}]},
    {"id": 11, "type": "timeseries", "title": "Workload run time p50 / p95 by type", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [
       {"expr": "histogram_quantile(0.5, sum by (le, capability) (rate(harness_workload_duration_seconds_bucket[15m])))", "legendFormat": "p50 {{capability}}", "refId": "A"},
       {"expr": "histogram_quantile(0.95, sum by (le, capability) (rate(harness_workload_duration_seconds_bucket[15m])))", "legendFormat": "p95 {{capability}}", "refId": "B"}]},
    {"id": 12, "type": "timeseries", "title": "Queue wait p95 by type", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [{"expr": "histogram_quantile(0.95, sum by (le, capability) (rate(harness_workload_queue_wait_seconds_bucket[15m])))", "legendFormat": "{{capability}}", "refId": "A"}]},
    {"id": 13, "type": "timeseries", "title": "Workloads by state", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [{"expr": "harness_workloads", "legendFormat": "{{state}}", "refId": "A"}]},

    {"id": 20, "type": "timeseries", "title": "Seconds since each device was heard from", "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [{"expr": "harness_node_heartbeat_age_seconds", "legendFormat": "{{node}}", "refId": "A"}]},
    {"id": 21, "type": "timeseries", "title": "Slots in use per device", "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [{"expr": "harness_node_slots_used", "legendFormat": "{{node}}", "refId": "A"}]},
    {"id": 22, "type": "timeseries", "title": "Devices held back, by reason", "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [{"expr": "harness_nodes_held_back > 0", "legendFormat": "{{reason}}", "refId": "A"}]},
    {"id": 23, "type": "timeseries", "title": "Reconnects and offline events (per hour)", "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [
       {"expr": "sum by (kind) (increase(harness_node_registrations_total[1h]))", "legendFormat": "registrations {{kind}}", "refId": "A"},
       {"expr": "sum by (reason) (increase(harness_node_offline_total[1h]))", "legendFormat": "offline {{reason}}", "refId": "B"}]},

    {"id": 30, "type": "timeseries", "title": "API requests per second by status class", "gridPos": {"x": 0, "y": 36, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [{"expr": "sum by (code) (rate(harness_http_requests_total[5m]))", "legendFormat": "{{code}}", "refId": "A"}]},
    {"id": 31, "type": "timeseries", "title": "API latency p95 by route", "gridPos": {"x": 12, "y": 36, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(harness_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "refId": "A"}]},
    {"id": 32, "type": "timeseries", "title": "File store traffic (bytes/s)", "gridPos": {"x": 0, "y": 44, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "fieldConfig": {"defaults": {"unit": "Bps"}},
     "targets": [{"expr": "sum by (direction, via) (rate(harness_artifact_bytes_total[5m]))", "legendFormat": "{{direction}} ({{via}})", "refId": "A"}]},
    {"id": 33, "type": "timeseries", "title": "Storage", "gridPos": {"x": 12, "y": 44, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "fieldConfig": {"defaults": {"unit": "bytes"}},
     "targets": [
       {"expr": "harness_artifact_store_used_bytes", "legendFormat": "files used", "refId": "A"},
       {"expr": "harness_artifact_store_limit_bytes", "legendFormat": "files limit", "refId": "B"},
       {"expr": "harness_store_size_bytes", "legendFormat": "database", "refId": "C"}]},

    {"id": 40, "type": "timeseries", "title": "Jobs and workflows finished (per hour)", "gridPos": {"x": 0, "y": 52, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [
       {"expr": "sum by (state) (increase(harness_jobs_finished_total[1h]))", "legendFormat": "jobs {{state}}", "refId": "A"},
       {"expr": "sum by (state) (increase(harness_workflows_finished_total[1h]))", "legendFormat": "workflows {{state}}", "refId": "B"}]},
    {"id": 41, "type": "timeseries", "title": "Spot checks, retries, timeouts (per hour)", "gridPos": {"x": 12, "y": 52, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [
       {"expr": "sum by (result) (increase(harness_spot_checks_total[1h]))", "legendFormat": "spot check {{result}}", "refId": "A"},
       {"expr": "sum by (reason) (increase(harness_workload_retries_total[1h]))", "legendFormat": "retry {{reason}}", "refId": "B"},
       {"expr": "sum(increase(harness_workload_timeouts_total[1h]))", "legendFormat": "timeouts", "refId": "C"}]},
    {"id": 42, "type": "timeseries", "title": "Agent cache hit rate", "gridPos": {"x": 0, "y": 60, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
     "targets": [{"expr": "sum(rate(harness_agent_cache_hits_total[15m])) / clamp_min(sum(rate(harness_agent_cache_hits_total[15m])) + sum(rate(harness_agent_cache_misses_total[15m])), 1e-9)", "legendFormat": "hit rate", "refId": "A"}]},
    {"id": 43, "type": "timeseries", "title": "Standby lag and event streams", "gridPos": {"x": 12, "y": 60, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [
       {"expr": "harness_standby_lag_seconds", "legendFormat": "standby lag (s)", "refId": "A"},
       {"expr": "harness_event_stream_subscribers", "legendFormat": "event streams", "refId": "B"}]}
  ]
}
