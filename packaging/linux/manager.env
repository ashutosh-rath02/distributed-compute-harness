# Extra flags for the Home Harness manager (home-harness-manager.service).
# Edit, then: sudo systemctl restart home-harness-manager
#
# The paths, ports and pairing token are set by the service already; see
# `home-harness-manager -help` for everything else. Examples:
#   -advertise-addr 192.168.1.20:7420      the address devices should use to reach this machine
#   -relay-addr relay.example.com:8420 -relay-token <secret>
#   -artifact-store-size 20GiB
#
# The operator token (what harnessctl and the API need) is created on first
# start in /var/lib/home-harness/manager/operator-token, readable by root only.
MANAGER_ARGS=""
