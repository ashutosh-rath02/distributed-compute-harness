<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Home Harness manager as a per-user launch agent: starts when you log in,
     restarts if it stops. Installed to /Library/LaunchAgents by the .pkg, or
     copy it to ~/Library/LaunchAgents and run:
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.homeharness.manager.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.homeharness.manager</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/usr/local/libexec/home-harness/run-manager.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>ProcessType</key><string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- A promoted standby exits and lets launchd start it again. -->
    <key>HOME_HARNESS_SUPERVISED</key><string>1</string>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
